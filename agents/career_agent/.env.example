# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cognipath

# LLM settings
# ollama (local, default) or claude
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=600
ANTHROPIC_API_KEY=your-api-key-here

# Gmail (optional, for reading job alert emails; use an app password)
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=your-app-password-here

# Shared team backend (Planner API). Run it from the repo root: uvicorn backend.main:app --reload
PLANNER_URL=http://127.0.0.1:8000
# Jooble job search API (free key from the Jooble API form; one key per country)
JOOBLE_API_KEY=your-jooble-key-here
JOOBLE_HOST=https://fi.jooble.org
JOOBLE_LOCATION=Finland
# Event Agent API (optional). Without a token the advisor uses data/events.json.
# Run it from the repo root: python -m uvicorn agents.event_agent.api:app --port 8002
EVENT_AGENT_URL=http://127.0.0.1:8002
EVENT_AGENT_TOKEN=a-user-token-from-the-event-agent
